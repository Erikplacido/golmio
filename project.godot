; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="FOTEBA"
config/description="Simulador tático & card game de futebol (modelo assíncrono)."
run/main_scene="res://presentation/boot/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

App="*res://core/boot/app.gd"
Settings="*res://presentation/settings/settings_service.gd"
Sfx="*res://presentation/audio/sfx_service.gd"
Game="*res://presentation/state/game_store.gd"
Router="*res://presentation/shell/router.gd"

[display]

window/size/viewport_width=1100
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[gui]

theme/custom_font="res://assets/fonts/Lexend-Variable.ttf"

[internationalization]

locale/translations=PackedStringArray("res://i18n/termos.pt_BR.translation")
locale/fallback="pt_BR"

[rendering]

textures/vram_compression/import_etc2_astc=true

textures/canvas_textures/default_texture_filter=3
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
